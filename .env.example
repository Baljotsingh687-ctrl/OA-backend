# Any PostgreSQL database (local or hosted)
DATABASE_URL=postgresql://postgres:password@localhost:5432/oa_screening
# Set to true only if your hosted Postgres requires SSL
DATABASE_SSL=false

# Secret used to sign login tokens (JWT). Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Shared key the hardware (ESP32) sends in the `x-device-key` header when uploading sensor data
DEVICE_API_KEY=change-me-device-key

PORT=4000
NODE_ENV=development

# Optional: if your ML team exposes a hosted model endpoint (FastAPI/Flask),
# the risk engine will call it and fall back to the rule-based scorer if unset
# or if the call fails/times out.
ML_MODEL_ENDPOINT=
ML_MODEL_TIMEOUT_MS=3000

# Gait video model (FastAPI service from github.com/aatsanjam-kaur/gait-api).
# Base URL only, no trailing path, e.g. http://localhost:8000 or https://your-gait-api.onrender.com
GAIT_API_URL=http://localhost:8000
# Pose extraction is slow (and free hosts cold-start), so allow a long timeout
GAIT_API_TIMEOUT_MS=120000
# Max accepted walking-video upload size
GAIT_MAX_VIDEO_MB=50

# Sensor (IMU) model - hosted FastAPI behind ngrok
SENSOR_API_URL=https://gangly-gown-observant.ngrok-free.dev/analyze-sensor
SENSOR_API_KEY=bbg sensor
# Header that carries the key, and how the readings are sent (csv = file upload, json = JSON body).
# Adjust these to match the sensor service if it rejects requests.
SENSOR_API_KEY_HEADER=x-api-key
SENSOR_API_MODE=csv
SENSOR_API_FILE_FIELD=file
SENSOR_API_TIMEOUT_MS=60000
